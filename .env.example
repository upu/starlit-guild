# Local development only. Hosted values are configured separately in Sites.
# Only the exact string true enables test profile creation and adjustment.
# npm run dev enables this by default. Set false to check the normal UI locally.
ENABLE_TEST_TOOLS=true

# Optional public Discord invite. Leave empty to hide community links.
# Set the actual URL in an ignored .env file or in each Site's runtime environment.
DISCORD_INVITE_URL=
