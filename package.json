{
  "name": "starlit-guild",
  "version": "0.5.9",
  "private": true,
  "license": "UNLICENSED",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "videos:optimize": "node scripts/optimize-story-videos.mjs",
    "videos:check": "node scripts/optimize-story-videos.mjs --check",
    "assets:optimize": "npm run images:optimize && npm run videos:optimize && npm run stills:optimize && npm run music:optimize && npm run road-art:optimize && npm run home-art:optimize && npm run adventure-art:optimize && npm run enemy-art:optimize && npm run story-stage-art:optimize",
    "story-stage-art:optimize": "node scripts/build-story-stage-art.mjs",
    "story-stage-art:check": "node scripts/build-story-stage-art.mjs --check",
    "predev": "npm run assets:optimize",
    "prebuild": "npm run assets:optimize",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vinext dev --hostname 0.0.0.0 --port 5173",
    "build": "vinext build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "manual-tests:check": "node scripts/check-manual-test-inventory.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:check-pr": "node scripts/check-pr-version.mjs",
    "db:generate": "drizzle-kit generate",
    "images:optimize": "node scripts/optimize-scenery.mjs",
    "images:check": "node scripts/optimize-scenery.mjs --check",
    "stills:optimize": "node scripts/optimize-story-stills.mjs",
    "stills:check": "node scripts/optimize-story-stills.mjs --check",
    "music:compose": "node scripts/compose-bgm.mjs && npm run music:optimize",
    "music:optimize": "node scripts/optimize-bgm.mjs",
    "music:check": "node scripts/optimize-bgm.mjs --check",
    "script:export": "node scripts/export-script.mjs",
    "script:check": "node scripts/export-script.mjs --check",
    "road-art:optimize": "node scripts/optimize-road-art.mjs",
    "road-art:check": "node scripts/optimize-road-art.mjs --check",
    "social-card:generate": "node scripts/generate-social-card.mjs",
    "social-card:check": "node scripts/generate-social-card.mjs --check",
    "presets:generate": "node scripts/generate-test-presets.mjs",
    "presets:check": "node scripts/generate-test-presets.mjs --check",
    "home-art:optimize": "node scripts/build-home-pixel.mjs",
    "home-art:check": "node scripts/build-home-pixel.mjs --check",
    "adventure-art:optimize": "node scripts/build-adventure-pixel.mjs",
    "enemy-art:optimize": "node scripts/build-enemy-pixel.mjs",
    "enemy-art:check": "node scripts/build-enemy-pixel.mjs --check",
    "adventure-art:check": "node scripts/build-adventure-pixel.mjs --check"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "phaser": "4.2.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "5.20261008.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-sonarjs": "^4.2.1",
    "prettier": "3.9.9",
    "react-server-dom-webpack": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vinext": "1.0.0-beta.11",
    "vite": "8.3.1",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "miniflare": {
      "sharp": "$sharp"
    }
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "unrs-resolver": true
  }
}
